# Maximum repeatable context measured on 2026-11-17. Very high TTFT; use only
# when long documents matter more than latency. Uses 4 GiB CPU offload.
MODEL_ID=qwen36-27b-long-context
MODEL_PATH=/data/llm/models/Qwen3.6-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.6-27b-long
HOST=127.0.0.1
PORT=8005
RUNNER=generate
DTYPE=float16
QUANTIZATION=inc
VLLM_XPU_INC_WNA16_BACKEND=w4a16
MAX_MODEL_LEN=41600
MAX_NUM_BATCHED_TOKENS=1024
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.96
CPU_OFFLOAD_GB=4
MIN_AVAILABLE_GIB=32
LANGUAGE_MODEL_ONLY=0
ENFORCE_EAGER=1
EXPECTED_VLLM_VERSION=0.33.0
