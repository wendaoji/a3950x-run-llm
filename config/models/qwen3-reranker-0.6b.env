# Qwen3 cross-encoder reranker using the upstream vLLM conversion/template.
MODEL_ID=qwen3-reranker-0.6b
MODEL_PATH=/data/llm/models/Qwen3-Reranker-0.6B
SERVED_MODEL_NAME=qwen3-reranker-0.6b
HOST=127.0.0.1
PORT=8002
RUNNER=pooling
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.35
MIN_AVAILABLE_GIB=20
HF_OVERRIDES_JSON='{"architectures":["Qwen3ForSequenceClassification"],"classifier_from_token":["no","yes"],"is_original_qwen3_reranker":true}'
CHAT_TEMPLATE=/data/llm/models/Qwen3-Reranker-0.6B/chat_template.jinja
LANGUAGE_MODEL_ONLY=0
EXPECTED_VLLM_VERSION=0.33.0
