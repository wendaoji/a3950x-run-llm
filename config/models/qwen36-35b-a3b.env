# Tested comparison setup. This is tighter than the 27B model and uses 4 GiB CPU offload.
MODEL_ID=qwen36-35b-a3b
MODEL_PATH=/data/llm/models/Qwen3.6-35B-A3B-int4-mixed-AutoRound
SERVED_MODEL_NAME=qwen3.6-35b-a3b
HOST=127.0.0.1
PORT=8004
RUNNER=generate
DTYPE=float16
QUANTIZATION=inc
VLLM_XPU_INC_WNA16_BACKEND=w4a16
MAX_MODEL_LEN=4096
MAX_NUM_BATCHED_TOKENS=1024
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.96
CPU_OFFLOAD_GB=4
MIN_AVAILABLE_GIB=28
LANGUAGE_MODEL_ONLY=0
ENFORCE_EAGER=1
EXPECTED_VLLM_VERSION=0.33.0
