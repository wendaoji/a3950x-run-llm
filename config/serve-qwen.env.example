# Copy to /data/llm/config/serve-qwen.env on a3950x and adjust after checking
# current free memory, model metadata, and the exact vLLM/XPU build.
LLM_ROOT=/data/llm
VLLM_ENV=/data/llm/envs/vllm-xpu-0.33.0
MODEL_PATH=/data/llm/models/Qwen3.6-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.6-27b
HOST=127.0.0.1
PORT=8000
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90
MIN_AVAILABLE_GIB=24
ZE_AFFINITY_MASK=0
